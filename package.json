{
  "name": "agvreddynco-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:gh-pages": "cross-env GITHUB_PAGES=true next build && node -e \"require('fs').writeFileSync('out/.nojekyll', '')\"",
    "build:custom-domain": "cross-env GITHUB_PAGES=false next build && node -e \"require('fs').writeFileSync('out/.nojekyll', '')\"",
    "postbuild": "node -e \"require('fs').writeFileSync('out/.nojekyll', '')\"",
    "deploy": "npm run build:gh-pages && npx gh-pages -d out --dotfiles --nojekyll",
    "deploy:gh-pages": "npm run build:gh-pages && npx gh-pages -d out --dotfiles --nojekyll",
    "deploy:custom-domain": "npm run build:custom-domain && npx gh-pages -d out --dotfiles --nojekyll",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.2.6",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.400.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.77.0",
    "react-redux": "^9.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.41",
    "sass": "^1.100.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
